{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runvibe.dev/contracts/subscription-domain-event-v1.schema.json",
  "title": "Subscription domain event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "aggregate_type",
    "aggregate_id",
    "sequence",
    "occurred_at",
    "workspace_id",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "description": "Versioned domain fact. Wallet provisioning emits workspace_provisioning.started, workspace_provisioning.completed, or workspace_provisioning.failed.",
      "examples": [
        "workspace_provisioning.started",
        "workspace_provisioning.completed",
        "workspace_provisioning.failed"
      ]
    },
    "schema_version": { "const": 1 },
    "aggregate_type": { "type": "string", "minLength": 1 },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "workspace_id": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "causation_id": { "type": ["string", "null"], "format": "uuid" },
    "payload": { "type": "object" }
  }
}
