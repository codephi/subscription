{
  "name": "tasklab-poc",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "cargo run --manifest-path backend/Cargo.toml -- setup",
    "dev": "concurrently -k -n api,web -c blue,green \"cargo run --manifest-path backend/Cargo.toml\" \"bash scripts/wait-for-api.sh && vite --config web/vite.config.ts\"",
    "test": "cargo test --manifest-path backend/Cargo.toml && vitest run --config web/vite.config.ts && playwright test --config web/playwright.config.ts",
    "test:e2e": "playwright test --config web/playwright.config.ts",
    "build": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "ui:info": "shadcn info --json",
    "ui:add": "shadcn add"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "shadcn": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
